# ============================================================
#  PyReader — AI 配置示例
#  复制本文件为 .env，填入你的密钥后保存即可。
#  程序启动时自动读取，无需手动在设置界面填写。
# ============================================================

# ---- Azure AI Foundry（推荐：gpt-5-mini）----
#
# 1. 登录 https://ai.azure.com → 选择你的项目
# 2. 左栏 "Models + endpoints" → Deploy model → 部署 gpt-5-mini
# 3. 部署完成后点进去，复制：
#      Endpoint   → 填到 DEEPSEEK_BASE_URL（末尾加 /openai/v1）
#      API Key    → 填到 DEEPSEEK_API_KEY
#      Deployment Name（部署名）→ 填到 DEEPSEEK_MODEL
#
# 注意：
#   · DEEPSEEK_BASE_URL 末尾必须是 /openai/v1
#   · DEEPSEEK_MODEL 填"部署名"，不是模型名
#     （两者可以相同，也可以不同，以 Azure 页面上显示的 Deployment Name 为准）
#   · gpt-5 系列拒绝 temperature 参数，必须保留 CODING_AGENT_TEMPERATURE=none

DEEPSEEK_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
DEEPSEEK_API_KEY=your-azure-api-key-here
DEEPSEEK_MODEL=gpt-5-mini
CODING_AGENT_TEMPERATURE=none


# ---- 备选方案 ----
# 取消注释下面任意一段，并注释掉上面的 Azure 段即可切换。

# -- OpenAI 官方 --
# DEEPSEEK_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=gpt-4o-mini

# -- DeepSeek --
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat

# -- 本地 Ollama（无需 API Key）--
# DEEPSEEK_BASE_URL=http://localhost:11434/v1
# DEEPSEEK_API_KEY=ollama
# DEEPSEEK_MODEL=llama3
